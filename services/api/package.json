{
  "name": "api",
  "private": true,
  "scripts": {
    "bootstrap": "python3 -m venv .venv && .venv/bin/pip install -q -e '.[dev]'",
    "dev": ".venv/bin/uvicorn app.main:app --reload --port 8000",
    "migrate": ".venv/bin/alembic upgrade head",
    "seed": ".venv/bin/python -m app.seed",
    "lint": ".venv/bin/ruff check app tests",
    "test": ".venv/bin/pytest -q",
    "reset": "rm -f idea_district.db && .venv/bin/alembic upgrade head && .venv/bin/python -m app.seed"
  }
}
