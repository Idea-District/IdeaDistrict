# Local demo runs on SQLite with zero setup. Production uses Supabase Postgres:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./idea_district.db

# Which AI provider handles every model call:
#   mock — offline, scripted (default; also the on-stage fallback)
#   mila — Mila Evolve (https://mila-evolve.com); needs AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
# Optional: model (Mila default mila-kronos), thinking level (LOW | HIGH), timeout in seconds
AI_MODEL=
AI_THINKING_LEVEL=LOW
AI_TIMEOUT_SECONDS=30

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3100,http://localhost:8081
