# Local demo runs on SQLite with zero setup. Production uses Supabase Postgres:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./idea_district.db

# Which AI provider handles every model call: "mock" (offline, scripted) or a
# provider registered in app/services/ai/providers/__init__.py.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3100,http://localhost:8081
